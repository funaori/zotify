// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "zotify",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	// "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bullseye"
	"dockerFile": "../my.Dockerfile",

	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Use 'postCreateCommand' to run commands after the container is created.
	// "postCreateCommand": "pip3 install --user -r requirements.txt",

	// Configure tool-specific properties.
	// "customizations": {},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
	"runArgs": ["--rm"],
	"mounts": [
		"source=${localWorkspaceFolder}/dot.config/zotify/config.json,target=/root/.config/zotify/config.json,type=bind,consistency=cached",
		"source=${localWorkspaceFolder}/dot.config/zotify/credentials.json,target=/root/.local/share/zotify/credentials.json,type=bind,consistency=cached",
		"source=/mnt/disk2/zotify,target=/root/Music/Zotify Music,type=bind,consistency=cached"
	],
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"lfs.vscode-emacs-friendly",
				"liviuschera.noctis",
				"charliermarsh.ruff",
				"skeswa.skeswa-noctis"
			],
			"settings": {
				"workbench.colorTheme": "@skeswa's Noctis"
			}
		}
	},
	"postCreateCommand": "pip3 install --break-system-packages -r ./requirements_dev.txt"
}
